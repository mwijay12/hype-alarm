{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperAlarm Pro",
  "version": "0.1.0",
  "identifier": "com.hyperalarmpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HyperAlarm Pro",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "visible": true,
        "skipTaskbar": false,
        "focus": true
      },
      {
        "label": "widget",
        "title": "HyperAlarm Widget",
        "url": "index.html#/widget",
        "width": 380,
        "height": 175,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
