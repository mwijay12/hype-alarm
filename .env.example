# Copy to .env.local for local development — NEVER commit real keys.
# App reads user keys from Settings UI (local DB) at runtime; these are only for local dev convenience.

# Groq (https://console.groq.com)
GROQ_API_KEY=
VITE_GROQ_API_KEY=

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=

# ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
VITE_ELEVENLABS_API_KEY=

# Gemini (optional)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
